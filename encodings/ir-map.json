{
  "schemaVersion": 1,
  "hotlSpecVersion": "0.2",
  "encodingVersion": "2026-09-10.0",
  "rule": "A visual topology never compiles by silhouette. Compile only through this map. Unknown ids fail closed.",
  "channels": {
    "provider": {
      "layer": "visual",
      "hotl": null,
      "job": "outer hue family"
    },
    "model": {
      "layer": "visual",
      "hotl": null,
      "job": "core geometry"
    },
    "effort": {
      "layer": "visual",
      "hotl": null,
      "job": "orbit count + energy"
    },
    "topology": {
      "layer": "visual+ir",
      "hotl": "policies + declared edges",
      "job": "shape is declared coordination; mapping is required"
    },
    "operatingMode": {
      "layer": "visual",
      "hotl": null,
      "job": "temporal organization rune, not O_t"
    },
    "state": {
      "layer": "visual",
      "hotl": null,
      "job": "runtime cadence; observed O_t is a different object"
    },
    "economics": {
      "layer": "visual",
      "hotl": "constraints.budgets is declared, never evidence of spend"
    }
  },
  "fromHotl": {
    "sequence": "pipeline",
    "fanout": "parallel",
    "reducer": "cluster",
    "recursion": "hierarchy",
    "auction": "marketplace",
    "human_gate": "supervisor",
    "retry": null,
    "blackboard": "blackboard"
  },
  "topologies": {
    "solo": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "sequence"
        ],
        "fanIn": "all"
      },
      "typicalNodes": [
        "executor"
      ],
      "typicalEdges": [],
      "example": null,
      "note": "One declared executor. No fan-out."
    },
    "paired": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "sequence"
        ],
        "fanIn": "all"
      },
      "typicalNodes": [
        "executor",
        "verifier"
      ],
      "typicalEdges": [
        "dependency",
        "critique",
        "verification"
      ],
      "example": null,
      "note": "Two agents in direct partnership. Verification is an edge, not implied by the second dot."
    },
    "council": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "fanout",
          "reducer"
        ],
        "fanIn": "quorum"
      },
      "typicalNodes": [
        "executor",
        "verifier"
      ],
      "typicalEdges": [
        "dependency",
        "critique"
      ],
      "example": null,
      "note": "Quorum fan-in must be declared. The ring is not consensus."
    },
    "hierarchy": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "recursion"
        ],
        "fanIn": "all",
        "dynamic": {
          "allowed": true,
          "maxChildren": "finite",
          "maxDepth": "finite"
        }
      },
      "typicalEdges": [
        "delegation"
      ],
      "example": "examples/valid/bounded-recursion.json",
      "note": "Delegation depth is finite. Unbounded spawn fails closed."
    },
    "mesh": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "fanout"
        ],
        "fanIn": "all"
      },
      "typicalEdges": [
        "message",
        "data"
      ],
      "example": null,
      "note": "Every peer edge must be declared. There is no HOTL kind named mesh."
    },
    "ring": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "sequence"
        ],
        "fanIn": "all"
      },
      "typicalEdges": [
        "message"
      ],
      "forbidden": [
        "dependency cycle"
      ],
      "example": null,
      "note": "Ring is a directed message circuit. Dependency cycles fail closed."
    },
    "star": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "fanout"
        ],
        "fanIn": "all"
      },
      "typicalEdges": [
        "allocation",
        "delegation"
      ],
      "example": null,
      "note": "Hub-and-spoke is declared allocation/delegation, not implied centrality."
    },
    "swarm": {
      "status": "not-inferred",
      "requires": [
        "policies.dynamic.allowed",
        "finite maxChildren",
        "finite maxDepth",
        "reserved budget"
      ],
      "doesNotImply": [
        "consensus",
        "intelligence",
        "mesh",
        "marketplace"
      ],
      "typicalEdges": [
        "message"
      ],
      "example": null,
      "note": "Swarm is a visual silhouette. IR is bounded dynamic spawn, not a node kind."
    },
    "cluster": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "fanout",
          "reducer"
        ],
        "fanIn": "reducer"
      },
      "typicalEdges": [
        "dependency",
        "message"
      ],
      "example": "examples/valid/fanout-fanin.json",
      "note": "Subgraphs coordinate only at declared edges."
    },
    "parallel": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "fanout"
        ],
        "fanIn": "all"
      },
      "typicalEdges": [
        "dependency"
      ],
      "example": "examples/valid/fanout-fanin.json"
    },
    "pipeline": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "sequence",
          "retry"
        ],
        "fanIn": "all"
      },
      "typicalEdges": [
        "dependency",
        "verification"
      ],
      "example": "examples/valid/pipeline.json"
    },
    "supervisor": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "human_gate"
        ],
        "fanIn": "all"
      },
      "typicalNodes": [
        "verifier",
        "humanGate"
      ],
      "typicalEdges": [
        "control",
        "observation"
      ],
      "example": null,
      "note": "Supervisor is control/observation + an explicit humanGate, not a health color."
    },
    "blackboard": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "sequence"
        ],
        "fanIn": "all"
      },
      "typicalNodes": [
        "memory",
        "stateStore"
      ],
      "typicalEdges": [
        "data"
      ],
      "example": null,
      "note": "Shared memory is a node kind (memory/stateStore), not a topology kind."
    },
    "marketplace": {
      "status": "expressible",
      "policies": {
        "kinds": [
          "auction"
        ],
        "fanIn": "any",
        "auction": {
          "phases": [
            "announce",
            "bid",
            "award",
            "execute",
            "verify",
            "settle"
          ],
          "payment": "unsupported"
        }
      },
      "typicalEdges": [
        "allocation",
        "verification",
        "control"
      ],
      "example": "examples/valid/market.json",
      "note": "Marketplace is allocation policy \u03a0_t, not a product. Payment execution is unsupported."
    },
    "hybrid": {
      "status": "not-inferred",
      "requires": [
        "explicit policies.kinds listing every active pattern"
      ],
      "doesNotImply": [
        "union of all silhouettes",
        "craid",
        "swarm"
      ],
      "example": "examples/valid/craid.json",
      "note": "Unlabeled hybrid is invalid. The named program is C(RAID): Continuous Research, Analysis, Integration, Deployment. kinds must list sequence, fanout, reducer, human_gate. D to R is observation, never dependency. See spec/craid.md."
    },
    "unknown": {
      "status": "unspecified",
      "example": null,
      "note": "Topology unreported. Decoder stays dashed; validator does not invent a class."
    }
  }
}
