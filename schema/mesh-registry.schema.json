{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/aodl/schema/mesh-registry.schema.json",
  "title": "AODL Mesh Registry",
  "description": "Fail-closed catalog mapping AODL intent needs to existing domain tools. Not HOTL 0.3. Mesh fields never appear on orchestration documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hotlSpecVersion",
    "rule",
    "stages",
    "statuses",
    "evidence",
    "modalities",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "hotlSpecVersion": { "const": "0.2" },
    "rule": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "enum": [
          "specify",
          "resolve",
          "render",
          "plan",
          "execute",
          "verify",
          "evaluate",
          "learn"
        ]
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": ["reference", "candidate", "adapter", "native"]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "specification_validity",
          "intent_resolution",
          "retrieval",
          "human_judgment",
          "design_system_compliance",
          "type_correctness",
          "security_advisory",
          "dependency_health",
          "behavioral_correctness",
          "accessibility",
          "visual_similarity",
          "geometric_validity",
          "loudness",
          "asr_transcript",
          "codec_validity",
          "temporal_consistency",
          "collision",
          "manufacturability",
          "safety_constraint",
          "observed_outcome",
          "telemetry"
        ]
      }
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "web",
          "code",
          "documents",
          "images",
          "audio",
          "video",
          "3d",
          "cad",
          "games",
          "robotics",
          "smart-home",
          "physical",
          "rendered-ui",
          "ui"
        ]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "domain", "modalities", "role", "status", "satisfies"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "stage": {
          "enum": [
            "specify",
            "resolve",
            "render",
            "plan",
            "execute",
            "verify",
            "evaluate",
            "learn"
          ]
        },
        "domain": { "type": "string", "minLength": 1 },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "web",
              "code",
              "documents",
              "images",
              "audio",
              "video",
              "3d",
              "cad",
              "games",
              "robotics",
              "smart-home",
              "physical",
              "rendered-ui",
              "ui"
            ]
          }
        },
        "role": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["reference", "candidate", "adapter", "native"]
        },
        "satisfies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "specification_validity",
              "intent_resolution",
              "retrieval",
              "human_judgment",
              "design_system_compliance",
              "type_correctness",
              "security_advisory",
              "dependency_health",
              "behavioral_correctness",
              "accessibility",
              "visual_similarity",
              "geometric_validity",
              "loudness",
              "asr_transcript",
              "codec_validity",
              "temporal_consistency",
              "collision",
              "manufacturability",
              "safety_constraint",
              "observed_outcome",
              "telemetry"
            ]
          }
        },
        "note": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "inTree": { "type": "string", "minLength": 1 },
        "harnessId": { "type": "string", "minLength": 1 },
        "alsoStages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "specify",
              "resolve",
              "render",
              "plan",
              "execute",
              "verify",
              "evaluate",
              "learn"
            ]
          }
        }
      }
    }
  }
}
